__pycache__/
*.pyc
.pytest_cache/
.env

# GitHub deploy key for deploy/gcp — generated locally by setup.sh, holds
# the VM's read-only credential for cloning the private repo. Never commit
# this; it lives in GCE instance metadata, not git.
deploy/gcp/deploy_key
deploy/gcp/deploy_key.pub

# Cloudflare Tunnel token for deploy/gcp — pasted into setup.sh, holds the
# credential for the optional public-domain tunnel. Never commit this
# either; it lives in GCE instance metadata, not git.
deploy/gcp/cloudflare_tunnel_token
