# Copy to .env (or export in your shell) if not using docker compose defaults.
# +psycopg: the SQLAlchemy-flavored URL scheme (see alembic/env.py's own
# comment) — plain postgresql:// (no +psycopg) won't resolve to the right
# driver.
DATABASE_URL=postgresql+psycopg://postwarden:postwarden@localhost:5432/postwarden

# Optional: creates this login automatically on first boot if no user
# exists yet (see modules/auth/service.py's bootstrap_admin_from_env).
# Leave both blank and run `docker compose exec app python -m
# postwarden.cli create-user <name>` instead if you'd rather not put a
# password in this file.
POSTWARDEN_ADMIN_USER=
POSTWARDEN_ADMIN_PASSWORD=

# Optional: set to true only if something in front of uvicorn terminates
# real HTTPS itself (not true for the documented IAP-tunnel or
# Cloudflare-tunnel deployments). See config.py's postwarden_cookie_secure
# comment.
POSTWARDEN_COOKIE_SECURE=

# Optional, only used by the `cloudflared` compose profile (see
# deploy/gcp/README.md): the tunnel token from Cloudflare Zero Trust ->
# Networks -> Tunnels -> your tunnel. Never commit a real value.
CLOUDFLARE_TUNNEL_TOKEN=
